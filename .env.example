# Copy to .env for local runs. Never commit .env.

# "local" answers from data/sample with DuckDB; "fabric" queries the semantic model.
SEMANTIC_API_BACKEND=local
SEMANTIC_API_LOG_LEVEL=INFO

# Fabric backend
SEMANTIC_API_FABRIC_WORKSPACE_ID=
SEMANTIC_API_FABRIC_DATASET_ID=
# Either a Secrets Manager secret ARN (JSON with tenant_id, client_id, client_secret) ...
SEMANTIC_API_FABRIC_SECRET_ARN=
# ... or, for local testing only, the service principal values directly.
SEMANTIC_API_FABRIC_TENANT_ID=
SEMANTIC_API_FABRIC_CLIENT_ID=
SEMANTIC_API_FABRIC_CLIENT_SECRET=
